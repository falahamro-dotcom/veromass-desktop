{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://app.veromass.com/*",
      "http://localhost:5173/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-desktop-tools",
    "dialog:allow-open"
  ]
}
